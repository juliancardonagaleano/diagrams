#!/bin/sh
# Hook pre-push de IArk - DIAgrams: antes de empujar corre la verificación rápida (`npm run verify:fast`):
# comprobación de tipos + solo las pruebas de vitest que dependen de lo que cambiaste respecto a origin/master.
#
# Activarlo (una vez por clon):   npm run hooks:install      (equivale a `git config core.hooksPath .githooks`)
# Desactivarlo:                   git config --unset core.hooksPath
# Saltarlo en un push concreto:   git push --no-verify
#
# Es una ayuda para no empujar código roto, NO la barrera de calidad: la barrera real es el CI (.github/workflows/deploy-pages.yml:
# job `test` con typecheck y la suite completa de vitest, que además condiciona la publicación). Por eso este hook:
#  - solo ejecuta `verify:fast`, nunca la suite completa ni las pruebas e2e (eso es `npm run verify`, que no cambia);
#  - no bloquea si no puede ejecutarse (sin `npm` o sin `node_modules`): avisa y deja pasar, el CI lo comprobará;
#  - no verifica cuando el push solo borra ramas o etiquetas remotas, ni cuando no hay nada que empujar.
# Limitación de `--changed`: selecciona pruebas por el grafo de imports, así que no ve lo que una prueba lee del disco ni
# lo que ejecuta como proceso aparte (p. ej. el CLI empaquetado con tsup, `examples/`, `schema/`); tocar package.json o la
# configuración de vite/vitest sí lanza toda la suite. Para una verificación completa, `npm run verify`.
set -eu

# Git entrega por la entrada estándar una línea por referencia: <ref local> <sha local> <ref remota> <sha remota>.
# Un sha local formado solo por ceros significa «borrar la referencia remota».
algo_que_verificar=0
while read -r _ref_local sha_local _resto; do
  case "$sha_local" in
    *[!0]*) algo_que_verificar=1 ;;
  esac
done
if [ "$algo_que_verificar" = 0 ]; then
  exit 0
fi

# Los hooks se ejecutan en la raíz del árbol de trabajo; por si acaso, se fija.
cd "$(git rev-parse --show-toplevel)"

if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: no encuentro «npm»; me salto la verificación rápida (el CI la hará)." >&2
  exit 0
fi
if [ ! -d node_modules ]; then
  echo "pre-push: falta node_modules (ejecuta «npm ci»); me salto la verificación rápida (el CI la hará)." >&2
  exit 0
fi

if ! git rev-parse --verify --quiet origin/master >/dev/null; then
  echo "pre-push: no existe la referencia origin/master (ejecuta «git fetch origin master»); me salto la verificación rápida (el CI la hará)." >&2
  exit 0
fi

echo "pre-push: npm run verify:fast (tipos + pruebas afectadas desde origin/master)…" >&2
if ! npm run --silent verify:fast >&2; then
  echo "" >&2
  echo "pre-push: la verificación rápida falló y el push se ha cancelado." >&2
  echo "  - Corrige el fallo y vuelve a empujar, o" >&2
  echo "  - salta el hook con «git push --no-verify» (el CI volverá a comprobarlo y bloqueará la publicación si falla)." >&2
  exit 1
fi
