{
  "$id": "https://github.com/juliancardonagaleano/diagrams/schema/platform-document.schema.json",
  "title": "Documento de plataforma (DIAgrams)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "workspace": {
      "default": {
        "name": "Arquitectura de plataforma"
      },
      "type": "object",
      "properties": {
        "name": {
          "default": "Arquitectura de plataforma",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "iconPacks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "provider": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
              },
              "color": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "aliases": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              },
              "icons": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "paths": {
                      "minItems": 1,
                      "maxItems": 24,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 800,
                        "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9\\s,.eE+-]+$"
                      }
                    },
                    "kinds": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "cluster",
                              "vm",
                              "database",
                              "cache",
                              "queue",
                              "storage",
                              "load-balancer",
                              "gateway",
                              "dns",
                              "secret-store",
                              "registry",
                              "region",
                              "namespace",
                              "certificate",
                              "monitoring",
                              "other"
                            ]
                          },
                          {
                            "type": "string",
                            "const": "network"
                          }
                        ]
                      }
                    },
                    "keywords": {
                      "maxItems": 40,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      }
                    }
                  },
                  "required": [
                    "label",
                    "paths"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "provider",
              "color",
              "icons"
            ]
          }
        }
      }
    },
    "environments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dev",
              "test",
              "staging",
              "prod",
              "dr"
            ]
          },
          "provider": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "networks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "exposure": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "isolated"
            ]
          },
          "cidr": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "environmentId"
        ]
      }
    },
    "resources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "cluster",
              "vm",
              "database",
              "cache",
              "queue",
              "storage",
              "load-balancer",
              "gateway",
              "dns",
              "secret-store",
              "registry",
              "region",
              "namespace",
              "certificate",
              "monitoring",
              "other"
            ]
          },
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "networkId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "technology": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "provisioned",
              "decommissioned"
            ]
          },
          "iac": {
            "type": "boolean"
          },
          "owner": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "refType": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Tipo del enlace que declara `ref` (vocabulario abierto; sugeridos: depends-on, implements, deploys, protects, realizes, derives, documents). Sin él, el enlace es «depends-on»."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "region": {
            "type": "string"
          },
          "cpuLimit": {
            "type": "string"
          },
          "memoryLimit": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "counterpartOf": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "environmentId"
        ]
      }
    },
    "services": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "service",
              "worker",
              "job",
              "frontend"
            ]
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "slo": {
            "type": "string"
          },
          "sla": {
            "type": "string"
          },
          "external": {
            "type": "boolean"
          },
          "ref": {
            "type": "string"
          },
          "refType": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Tipo del enlace que declara `ref` (vocabulario abierto; sugeridos: depends-on, implements, deploys, protects, realizes, derives, documents). Sin él, el enlace es «depends-on»."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "deployments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "hostId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "version": {
            "type": "string"
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "cpuLimit": {
            "type": "string"
          },
          "memoryLimit": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "serviceId",
          "environmentId",
          "hostId"
        ]
      }
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "calls",
              "messages",
              "data"
            ]
          },
          "protocol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sourceId",
          "targetId",
          "kind"
        ]
      }
    },
    "pipelines": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "ci",
              "cd",
              "ci-cd",
              "iac"
            ]
          },
          "tool": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "serviceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "provisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "stages": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "environmentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "approval": {
                  "type": "boolean"
                }
              },
              "required": [
                "environmentId"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      }
    }
  }
}
