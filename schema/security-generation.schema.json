{
  "$id": "https://github.com/juliancardonagaleano/DIAgrams/schema/security-generation.schema.json",
  "title": "Modelo de seguridad (salida de IA)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "trust": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "untrusted",
                  "dmz",
                  "internal",
                  "restricted"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "trust",
          "parentId",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "actor",
              "external",
              "process",
              "datastore",
              "identity",
              "secret",
              "channel"
            ]
          },
          "zoneId": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "technology": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "encryptedAtRest": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "authentication": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "password",
                  "token",
                  "mtls",
                  "sso"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "rotation": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "encrypted": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "zoneId",
          "description",
          "technology",
          "owner",
          "classification",
          "encryptedAtRest",
          "authentication",
          "rotation",
          "encrypted"
        ],
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "encrypted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "authentication": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "password",
                  "token",
                  "mtls",
                  "sso"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "sourceId",
          "targetId",
          "description",
          "protocol",
          "classification",
          "encrypted",
          "authentication"
        ],
        "additionalProperties": false
      }
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "spoofing",
              "tampering",
              "repudiation",
              "information-disclosure",
              "denial-of-service",
              "elevation-of-privilege"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "likelihood": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "impact": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "open",
                  "mitigated",
                  "accepted"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "controlIds": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "targetId",
          "likelihood",
          "impact",
          "status",
          "description",
          "controlIds"
        ],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "authentication",
              "authorization",
              "encryption",
              "logging",
              "validation",
              "network",
              "rate-limit",
              "backup",
              "secrets",
              "other"
            ]
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "planned",
                  "implemented"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "description",
          "owner"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workspace",
    "zones",
    "assets",
    "flows",
    "threats",
    "controls"
  ],
  "additionalProperties": false
}
