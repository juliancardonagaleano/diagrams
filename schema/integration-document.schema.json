{
  "$id": "https://github.com/juliancardonagaleano/DIAgrams/schema/integration-document.schema.json",
  "title": "Documento de integración (DIAgrams)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "workspace": {
      "default": {
        "name": "Mapa de integración"
      },
      "type": "object",
      "properties": {
        "name": {
          "default": "Mapa de integración",
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "system",
              "api",
              "gateway",
              "broker",
              "queue",
              "topic",
              "store",
              "connector",
              "scheduler",
              "user",
              "mcp",
              "pattern"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "external": {
            "type": "boolean"
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "ref": {
            "type": "string"
          },
          "refType": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Tipo del enlace que declara `ref` (vocabulario abierto; sugeridos: depends-on, implements, deploys, protects, realizes, derives, documents). Sin él, el enlace es «depends-on»."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contractId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "pattern": {
            "type": "string",
            "enum": [
              "content-based-router",
              "message-translator",
              "splitter",
              "aggregator",
              "filter",
              "enricher",
              "publish-subscribe",
              "polling-consumer",
              "idempotent-receiver",
              "dead-letter-channel",
              "saga",
              "circuit-breaker",
              "wire-tap",
              "claim-check",
              "scatter-gather",
              "resequencer",
              "transactional-outbox",
              "retry"
            ]
          },
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name"
        ]
      }
    },
    "contracts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "openapi",
              "asyncapi",
              "graphql",
              "protobuf",
              "avro",
              "json-schema",
              "wsdl",
              "cloudevents",
              "mcp",
              "other"
            ]
          },
          "version": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "format"
        ]
      }
    },
    "interactions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "style": {
            "type": "string",
            "enum": [
              "request-response",
              "async-message",
              "event",
              "batch",
              "stream"
            ]
          },
          "protocol": {
            "type": "string"
          },
          "pattern": {
            "type": "string",
            "enum": [
              "content-based-router",
              "message-translator",
              "splitter",
              "aggregator",
              "filter",
              "enricher",
              "publish-subscribe",
              "polling-consumer",
              "idempotent-receiver",
              "dead-letter-channel",
              "saga",
              "circuit-breaker",
              "wire-tap",
              "claim-check",
              "scatter-gather",
              "resequencer",
              "transactional-outbox",
              "retry"
            ]
          },
          "contractId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string"
          },
          "dataObjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "order": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "sourceId",
          "targetId",
          "style"
        ]
      }
    },
    "flows": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "steps": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "interactionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "interactionId"
              ]
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  }
}
