{
  "$id": "https://github.com/juliancardonagaleano/DIAgrams/schema/data-generation.schema.json",
  "title": "Modelo de datos (salida de IA)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "owner"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "database",
              "warehouse",
              "lake",
              "stream",
              "table",
              "view",
              "file",
              "report",
              "model",
              "data-product",
              "glossary",
              "data-api"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "technology": {
            "type": [
              "string",
              "null"
            ]
          },
          "engine": {
            "anyOf": [
              {
                "type": "string",
                "description": "Motor de base de datos: postgresql, mysql, sqlserver, oracle, sqlite, bigquery, snowflake, redshift, databricks, mongodb, cassandra, dynamodb, kafka"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "steward": {
            "type": [
              "string",
              "null"
            ]
          },
          "domainId": {
            "type": [
              "string",
              "null"
            ]
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "pii": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "retention": {
            "type": [
              "string",
              "null"
            ]
          },
          "external": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "columns": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "keys": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "pk",
                              "fk",
                              "uk"
                            ]
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "nullable": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "pii": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "type",
                    "keys",
                    "nullable",
                    "pii",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "inputPorts": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "outputPorts": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "exposes": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "freshness": {
            "type": [
              "string",
              "null"
            ]
          },
          "sla": {
            "type": [
              "string",
              "null"
            ]
          },
          "protocol": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "rest",
                  "graphql",
                  "grpc",
                  "odata",
                  "sql",
                  "events"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "technology",
          "engine",
          "owner",
          "steward",
          "domainId",
          "parentId",
          "classification",
          "pii",
          "retention",
          "external",
          "columns",
          "inputPorts",
          "outputPorts",
          "exposes",
          "freshness",
          "sla",
          "protocol",
          "endpoint"
        ],
        "additionalProperties": false
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "batch",
              "elt",
              "cdc",
              "streaming",
              "replication",
              "api",
              "manual"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "schedule": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "anonymizes": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mappings": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "object",
                      "properties": {
                        "assetId": {
                          "type": "string"
                        },
                        "column": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "assetId",
                        "column"
                      ],
                      "additionalProperties": false
                    },
                    "to": {
                      "type": "object",
                      "properties": {
                        "assetId": {
                          "type": "string"
                        },
                        "column": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "assetId",
                        "column"
                      ],
                      "additionalProperties": false
                    },
                    "transform": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "transform"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "inputs",
          "outputs",
          "tool",
          "schedule",
          "description",
          "owner",
          "anonymizes",
          "mappings"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "1:1",
              "1:N",
              "N:1",
              "N:M"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceMin": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0,
                  1
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "targetMin": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0,
                  1
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "sourceId",
          "targetId",
          "cardinality",
          "description",
          "sourceMin",
          "targetMin"
        ],
        "additionalProperties": false
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "draft",
                  "approved",
                  "deprecated"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "glossaryId": {
            "type": [
              "string",
              "null"
            ]
          },
          "synonyms": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "links": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "type": "string"
                    },
                    "column": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "column"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "definition",
          "owner",
          "status",
          "glossaryId",
          "synonyms",
          "links"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workspace",
    "domains",
    "assets",
    "pipelines",
    "relations",
    "terms"
  ],
  "additionalProperties": false
}
