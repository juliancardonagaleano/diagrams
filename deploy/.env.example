# Configuración del despliegue (docker-compose.yml). Copia este archivo a `.env` en esta misma carpeta y rellena lo obligatorio.
# `.env` no se sube a git. AQUÍ NO VA NINGÚN SECRETO: el Client secret de la OAuth App va en secrets/github_client_secret.
# Guía paso a paso: docs/despliegue-nube.md

# ───── Obligatorio ─────

# El dominio (o subdominio) donde vivirá el servicio, SIN «https://» ni barra final: iark.ejemplo.org
# Su registro DNS (tipo A, y AAAA si la máquina tiene IPv6) debe apuntar a la máquina. De él salen la dirección pública
# (https://<dominio>) y la «Authorization callback URL» de la OAuth App: https://<dominio>/api/auth/github/callback
IARK_DOMAIN=

# El «Client ID» de la OAuth App de GitHub (Settings → Developer settings → OAuth Apps). Es público; el secreto no.
IARK_GITHUB_CLIENT_ID=

# Quién administra la instancia: identificadores numéricos de GitHub, separados por comas (mejor que el nombre de usuario,
# que puede pasar a otra persona si su dueña lo cambia). Se obtienen con: curl https://api.github.com/users/<usuario>  (campo "id")
IARK_ADMINS=

# ───── Opcional (quita la almohadilla para cambiar el valor por omisión) ─────

# Quién puede entrar: invite (por omisión; solo administradores y personas invitadas) u open (cualquiera con cuenta de GitHub).
#IARK_SIGNUP=invite

# Orígenes que pueden llamar a la API desde un navegador y a los que se vuelve tras iniciar sesión, separados por comas.
# Para usar esta instancia desde el sitio publicado en GitHub Pages: https://juliancardonagaleano.github.io
# (el compose la pasa a IArk como IARK_CORS, que es `--cors`; hace falta el origen exacto, sin ruta ni barra final)
#IARK_CORS=

# Sitios que pueden incrustar por iframe el editor y el banco de módulos (las cargas embebidas, ?embed=1), separados por comas. Por omisión
# cualquiera (*), porque el producto es embebible; si solo lo incrustas en tu propia aplicación, pon su origen: https://app.ejemplo.org
# (el compose la pasa a IArk como IARK_FRAME_ANCESTORS, que es `--frame-ancestors`; la propia instancia siempre puede)
#IARK_FRAME_ANCESTORS=*

# Cálculo pesado en hilos de trabajo (el compose los pasa a IArk como IARK_WORKERS, IARK_COMPUTE_TIMEOUT_MS e IARK_COMPUTE_QUEUE). Vacío =
# lo que decide el servicio: min(2, CPU - 1) hilos, 30 s por operación (milisegundos o «30s») y 16 operaciones en cola. Cada hilo suma unos
# 70 MB: si subes los hilos, sube también mem_limit en docker-compose.yml.
#IARK_WORKERS=
#IARK_COMPUTE_TIMEOUT_MS=
#IARK_COMPUTE_QUEUE=

# Días que dura una sesión (30 por omisión) y cuotas por persona (los administradores de la instancia no tienen tope; 0 quita un tope):
# proyectos que posee (25), diagramas por proyecto (200) y espacio total con el historial de versiones (256M; admite 500K, 1.5G…).
#IARK_SESSION_DAYS=
#IARK_MAX_PROJECTS=
#IARK_MAX_DIAGRAMS=
#IARK_MAX_BYTES=

# Solo con GitHub Enterprise Server: su dirección y su API.
#IARK_GITHUB_URL=https://git.empresa.com
#IARK_GITHUB_API_URL=https://git.empresa.com/api/v3

# Registros y métricas (docs/observabilidad.md). El compose ya los enciende: los accesos a la salida estándar (`docker compose logs iark`) y
# la auditoría a un archivo del volumen. Aquí solo se cambia el destino; para apagarlos, quita la línea correspondiente del compose.
# Llevan datos personales (el usuario de GitHub y la dirección IP): ver «Datos personales» en la guía.
#IARK_ACCESS_LOG=-
#IARK_AUDIT_LOG=/data/audit.jsonl

# Métricas de Prometheus en GET /metrics: apagadas por omisión. Para encenderlas, IARK_METRICS=1 y un token de 16 a 256 caracteres
# (openssl rand -hex 32); sin token el servicio se niega a arrancar porque escucha fuera de loopback. Caddy no las publica.
#IARK_METRICS=1
#IARK_METRICS_TOKEN=
