# Caddy: da HTTPS a DIAgrams y renueva solo el certificado (gratuito, de Let's Encrypt o ZeroSSL). Lo usa el docker-compose.yml de esta carpeta.
#
# IARK_DOMAIN es el dominio (o subdominio) del servicio, sin «https://» (se pone en deploy/.env): Caddy pide el certificado de
# ese nombre y redirige el puerto 80 al 443. Para que lo consiga, el registro DNS del dominio debe apuntar a esta máquina y los
# puertos 80 y 443 deben estar abiertos.
{
	# Sin HTTP/3: el compose publica solo 80 y 443/TCP (el UDP 443 de HTTP/3 habría que abrirlo aparte).
	servers {
		protocols h1 h2
	}
}

{$IARK_DOMAIN} {
	# Sin comprimir el canal de cambios en tiempo real (GET /api/events, Server-Sent Events): una conexión larga que debe salir al instante.
	@sinsse not path /api/events
	encode @sinsse zstd gzip
	# Cabeceras de borde (spec 009): política de src/cli/securityHeaders.ts. Pages usa dist/pages/_headers con la misma CSP.
	header {
		>Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options nosniff
	}
	@html path *.html / /index.html /modulos.html /suite.html /trazabilidad.html
	header @html {
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; frame-src 'self' https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		X-Frame-Options "SAMEORIGIN"
	}
	# `iark` es el nombre del servicio en el compose; su puerto no se publica fuera. Caddy añade X-Forwarded-For con la dirección
	# del cliente, y por eso DIAgrams arranca con --trust-proxy (el freno de intentos fallidos distingue a cada cliente).
	# Caddy no activa su propio registro de accesos (es lo normal en Caddy): la dirección de vuelta de GitHub lleva un código de un solo uso en la
	# query string. El registro de accesos es el de DIAgrams (IARK_ACCESS_LOG, en el compose), que nunca anota la query string; ver docs/observabilidad.md.
	# /metrics (si se activa con IARK_METRICS) lo lee Prometheus por la red interna, en iark:8787; DIAgrams lo protege con token, y para que ni
	# siquiera llegue desde internet se puede cerrar aquí, antes del proxy (no está puesto por omisión):
	#   @metricas path /metrics
	#   respond @metricas 404
	# flush_interval -1: cada aviso del canal /api/events sale sin esperar a llenar un búfer (Caddy ya lo hace solo con text/event-stream; se deja
	# explícito). Sin probar con un Caddy real: no lo hay en el entorno donde se escribió esto.
	reverse_proxy iark:8787 {
		flush_interval -1
	}
}
