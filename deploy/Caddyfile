# Caddy: da HTTPS a IArk y renueva solo el certificado (gratuito, de Let's Encrypt o ZeroSSL). Lo usa el docker-compose.yml de esta carpeta.
#
# IARK_DOMAIN es el dominio (o subdominio) del servicio, sin «https://» (se pone en deploy/.env): Caddy pide el certificado de
# ese nombre y redirige el puerto 80 al 443. Para que lo consiga, el registro DNS del dominio debe apuntar a esta máquina y los
# puertos 80 y 443 deben estar abiertos.
{
	# Sin HTTP/3: el compose publica solo 80 y 443/TCP (el UDP 443 de HTTP/3 habría que abrirlo aparte).
	servers {
		protocols h1 h2
	}
}

{$IARK_DOMAIN} {
	encode zstd gzip
	# `iark` es el nombre del servicio en el compose; su puerto no se publica fuera. Caddy añade X-Forwarded-For con la dirección
	# del cliente, y por eso IArk arranca con --trust-proxy (el freno de intentos fallidos distingue a cada cliente).
	# No se activa el registro de accesos (es lo normal en Caddy): la dirección de vuelta de GitHub lleva un código de un solo uso.
	reverse_proxy iark:8787
}
