{
  "name": "@iark/domain-c4",
  "version": "0.1.0",
  "description": "DIAgrams: módulo de arquitectura de soluciones (modelo C4): documento, vistas, autolayout, importadores y exportadores, prompts de IA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliancardonagaleano/iark-diagrams.git",
    "directory": "packages/domain-c4"
  },
  "homepage": "https://github.com/juliancardonagaleano/iark-diagrams#readme",
  "bugs": {
    "url": "https://github.com/juliancardonagaleano/iark-diagrams/issues"
  },
  "keywords": [
    "iark",
    "architecture",
    "diagrams",
    "c4"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./module": "./src/module.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"console.error('Este package.json es el de desarrollo (su exports apunta a src/*.ts): no se publica. Ejecuta npm run packages:build en la raíz y publica ./dist-packages/domain-c4'); process.exit(1)\""
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./module": {
        "types": "./dist/module.d.ts",
        "default": "./dist/module.js"
      }
    }
  },
  "dependencies": {
    "@iark/kernel": "*",
    "elkjs": "^0.12.0",
    "fast-xml-parser": "^5.3.4",
    "nanoid": "^5.1.6",
    "zod": "^4.3.3"
  }
}
