{
  "name": "@iark/domain-enterprise",
  "version": "0.1.0",
  "description": "DIAgrams: módulo de arquitectura empresarial (capacidades, procesos, aplicaciones y tecnología)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliancardonagaleano/diagrams.git",
    "directory": "packages/domain-enterprise"
  },
  "homepage": "https://github.com/juliancardonagaleano/diagrams#readme",
  "bugs": {
    "url": "https://github.com/juliancardonagaleano/diagrams/issues"
  },
  "keywords": [
    "iark",
    "architecture",
    "diagrams",
    "enterprise"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"console.error('Este package.json es el de desarrollo (su exports apunta a src/*.ts): no se publica. Ejecuta npm run packages:build en la raíz y publica ./dist-packages/domain-enterprise'); process.exit(1)\""
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@iark/kernel": "*",
    "fast-xml-parser": "^5.3.4",
    "zod": "^4.3.3"
  }
}
