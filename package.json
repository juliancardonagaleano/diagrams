{
  "name": "iark-diagrams",
  "version": "0.1.0",
  "description": "IArk - DIAgrams: suite de diagramación de arquitectura (hoy modelo C4) con autolayout, exportación a .drawio, CLI con IA y modo embebido por iframe",
  "type": "module",
  "license": "MIT",
  "bin": {
    "iark": "./dist/cli/index.js",
    "c4diagram": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./embed": {
      "types": "./dist/embed/iark-embed.d.ts",
      "import": "./dist/embed/iark-embed.js"
    },
    "./element": {
      "types": "./dist/embed/iark-module-element.d.ts",
      "import": "./dist/embed/iark-module-element.js"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "schema",
    "examples"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:app",
    "build:lib": "tsup",
    "build:app": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "schema": "tsx scripts/generate-schema.ts",
    "manifest": "tsx scripts/generate-manifest.ts",
    "cli": "tsx src/cli/index.ts",
    "e2e": "playwright test",
    "deploy:pages": "bash scripts/deploy-gh-pages.sh",
    "docker:smoke": "tsx scripts/docker-smoke-cuentas.ts",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm test && npm run build && npm run e2e",
    "verify:fast": "npm run typecheck && vitest run --changed origin/master --passWithNoTests",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.5.0",
    "@anthropic-ai/sdk": "^0.128.0",
    "commander": "^15.0.0",
    "elkjs": "^0.12.0",
    "fast-xml-parser": "^5.3.4",
    "nanoid": "^5.1.6",
    "yaml": "^2.9.1",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@douyinfe/semi-icons": "^2.103.0",
    "@douyinfe/semi-ui": "^2.103.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "@xyflow/react": "^12.11.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "mermaid": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "lodash-es": "^4.18.1"
  }
}
