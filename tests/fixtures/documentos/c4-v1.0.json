{
  "version": "1.0",
  "workspace": {
    "name": "Banca en línea",
    "description": "Ejemplo clásico del modelo C4: sistema de banca por internet."
  },
  "model": {
    "elements": [
      {
        "id": "cliente",
        "type": "person",
        "name": "Cliente personal",
        "description": "Cliente del banco con cuentas personales."
      },
      {
        "id": "banca",
        "type": "softwareSystem",
        "name": "Sistema de banca en línea",
        "description": "Permite a los clientes ver información de sus cuentas y hacer pagos."
      },
      {
        "id": "mainframe",
        "type": "softwareSystem",
        "name": "Sistema bancario central",
        "description": "Almacena toda la información bancaria de clientes, cuentas y transacciones.",
        "external": true
      },
      {
        "id": "email",
        "type": "softwareSystem",
        "name": "Sistema de correo",
        "description": "Sistema de correo electrónico de Microsoft Exchange.",
        "external": true
      },
      {
        "id": "web-app",
        "type": "container",
        "name": "Aplicación web",
        "technology": "Java y Spring MVC",
        "description": "Entrega el contenido estático y la aplicación de una sola página.",
        "parentId": "banca",
        "shape": "browser"
      },
      {
        "id": "spa",
        "type": "container",
        "name": "Aplicación de una sola página",
        "technology": "JavaScript y Angular",
        "description": "Provee toda la funcionalidad de banca a los clientes desde el navegador.",
        "parentId": "banca"
      },
      {
        "id": "mobile-app",
        "type": "container",
        "name": "Aplicación móvil",
        "technology": "Xamarin",
        "description": "Provee un subconjunto de la funcionalidad de banca desde el móvil.",
        "parentId": "banca",
        "shape": "mobile"
      },
      {
        "id": "api",
        "type": "container",
        "name": "Aplicación API",
        "technology": "Java y Spring MVC",
        "description": "Provee la funcionalidad de banca mediante una API JSON/HTTPS.",
        "parentId": "banca"
      },
      {
        "id": "db",
        "type": "container",
        "name": "Base de datos",
        "technology": "Oracle Database",
        "description": "Almacena registro de usuarios, credenciales y logs de acceso.",
        "parentId": "banca",
        "shape": "database"
      },
      {
        "id": "signin",
        "type": "component",
        "name": "Controlador de inicio de sesión",
        "technology": "Spring MVC Rest Controller",
        "description": "Permite a los usuarios iniciar sesión.",
        "parentId": "api"
      },
      {
        "id": "accounts",
        "type": "component",
        "name": "Controlador de cuentas",
        "technology": "Spring MVC Rest Controller",
        "description": "Provee información de las cuentas del cliente.",
        "parentId": "api"
      },
      {
        "id": "security",
        "type": "component",
        "name": "Componente de seguridad",
        "technology": "Spring Bean",
        "description": "Provee funcionalidad de autenticación y cambio de contraseña.",
        "parentId": "api"
      },
      {
        "id": "mainframe-facade",
        "type": "component",
        "name": "Fachada del sistema central",
        "technology": "Spring Bean",
        "description": "Fachada sobre el sistema bancario central.",
        "parentId": "api"
      }
    ],
